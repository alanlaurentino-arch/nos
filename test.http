@baseUrl = http://localhost:4004
@auth    = Basic YWRtaW46YWRtaW4=

### ─── 1. Criar Produto ────────────────────────────────────────────────────────
POST {{baseUrl}}/service/Stock_NOSService/Product
Authorization: {{auth}}
Content-Type: application/json

{
  "productName"       : "Garrafa de Água 500ml",
  "productType"       : "Bebidas",
  "productSAPCode"    : "PRD-990182",
  "productDescription": "Garrafa reutilizável 500ml"
}

### ─── 2. Criar Location ──────────────────────────────────────────────────────
POST {{baseUrl}}/service/Stock_NOSService/Location
Authorization: {{auth}}
Content-Type: application/json

{
  "siteId"      : "CD01",
  "name"        : "CD Região SP 01",
  "locationType": "CD",
  "description" : "Centro de Distribuição - São Paulo"
}

### ─── 3. Criar Channel ───────────────────────────────────────────────────────
POST {{baseUrl}}/service/Stock_NOSService/Channel
Authorization: {{auth}}
Content-Type: application/json

{
  "code": "ECOMMERCE",
  "name": "E-commerce"
}

### ─── 4. Disparar evento de estoque (payload principal) ─────────────────────
POST {{baseUrl}}/service/Stock_NOSService/processInventoryEvent
Authorization: {{auth}}
Content-Type: application/json

{
  "header": {
    "eventId"     : "evt-nos-849201-9948",
    "timestamp"   : "2026-02-20T10:05:00Z",
    "sourceSystem": "SAP_BTP_NOS_ENGINE",
    "syncType"    : "DELTA",
    "totalRecords": 3
  },
  "positions": [
    {
      "sku"              : "PRD-990182",
      "siteId"           : "CD01",
      "channel"          : "ECOMMERCE",
      "inventoryType"    : "ON_HAND",
      "availableQuantity": 150.00,
      "unitOfMeasure"    : "UN",
      "lastMovementDate" : "2026-02-20T10:02:15Z"
    },
    {
      "sku"              : "PRD-990182",
      "siteId"           : "HUB-SP",
      "channel"          : "ECOMMERCE",
      "inventoryType"    : "EXTENDED",
      "availableQuantity": 500.00,
      "unitOfMeasure"    : "UN",
      "lastMovementDate" : "2026-02-20T09:45:00Z"
    },
    {
      "sku"              : "PRD-445091",
      "siteId"           : "CD02",
      "channel"          : "VAREJO",
      "inventoryType"    : "TRANSIT",
      "availableQuantity": 200.00,
      "unitOfMeasure"    : "UN",
      "lastMovementDate" : "2026-02-20T09:45:00Z",
      "transitId"        : "TR-881293",
      "estimatedArrival" : "2026-02-22T14:00:00Z"
    }
  ]
}

### ─── 5. Verificar movimentações criadas ────────────────────────────────────
GET {{baseUrl}}/service/Stock_NOSService/StockMovement
Authorization: {{auth}}

### ─── 6. Verificar saldo por produto/local ──────────────────────────────────
GET {{baseUrl}}/service/Stock_NOSService/StockBalance
Authorization: {{auth}}

### ─── 7. Verificar eventos recebidos ───────────────────────────────────────
GET {{baseUrl}}/service/Stock_NOSService/InventoryEvent
Authorization: {{auth}}
